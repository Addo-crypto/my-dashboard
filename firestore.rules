rules_version = '2';
// Addo.corp messages.
// Anyone can send one well-formed message. Only the owner can read, mark or delete.
// Replace OWNER_UID below with your User UID from Firebase Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'OWNER_UID';
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'type', 'message', 'page', 'read', 'createdAt'])
        && str(request.resource.data.name, 1, 100)
        && str(request.resource.data.email, 3, 200)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(request.resource.data.type, 0, 60)
        && str(request.resource.data.message, 1, 5000)
        && str(request.resource.data.page, 0, 20)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
